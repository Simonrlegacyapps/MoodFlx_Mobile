<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
	android:orientation="vertical"
    android:background="#FFFFFF">

	<LinearLayout
		android:layout_width="@dimen/widget_min_width"
		android:layout_height="@dimen/widget_button_height"
		android:orientation="horizontal">
		<TextView
			android:id="@+id/pretty_text_view_id"
			android:layout_height="@dimen/widget_button_height"
			android:layout_width="@dimen/widget_button_width"
			android:textColor="@color/black"
			android:autoSizeTextType="uniform"
			android:autoSizeMinTextSize="12sp"
			android:autoSizeMaxTextSize="14sp"
			android:gravity="center_horizontal|center_vertical"
			android:text="Pretty" />
		<TextView
			android:id="@+id/very_text_view_id"
			android:layout_height="@dimen/widget_button_height"
			android:layout_width="@dimen/widget_button_width"
			android:textColor="@color/black"
			android:gravity="center_horizontal|center_vertical"
			android:autoSizeTextType="uniform"
			android:autoSizeMinTextSize="12sp"
			android:autoSizeMaxTextSize="14sp"
			android:text="Very" />
		<TextView
			android:id="@+id/mood_name_text_view_id"
			android:layout_height="@dimen/widget_button_height"
			android:layout_width="@dimen/widget_button_width"
			android:textColor="@color/black"
			android:gravity="center_horizontal|center_vertical"
			android:autoSizeTextType="uniform"
			android:autoSizeMinTextSize="6sp"
			android:autoSizeMaxTextSize="8sp"
			android:text="@string/mood_name_default" />
		<Button
			android:id="@+id/save_button_id"
			android:layout_height="wrap_content"
			android:layout_width="wrap_content"
			android:textColor="@color/white"
			android:background="#A1C595"
			android:text="SAVE" />
	</LinearLayout>
